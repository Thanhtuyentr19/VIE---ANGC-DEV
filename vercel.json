{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://sites.google.com https://*.googleusercontent.com https://www.lydinc.net https://lydinc.net;" }
      ]
    }
  ],
  "cleanUrls": true
}